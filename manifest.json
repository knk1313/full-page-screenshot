{
  "manifest_version": 3,
  "name": "Full Page Screenshot",
  "version": "1.2.0",
  "description": "ページの上から下までを1枚のPNGとして保存・コピーします。",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "downloads",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ページ全体をスクショ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      }
    }
  }
}
